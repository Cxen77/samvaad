# Server Configuration
PORT=5000
NODE_ENV=development
# IMPORTANT: Set NODE_ENV=production on Render/production host
# IMPORTANT: Set CLIENT_URL to your frontend domain for CORS and cookies
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=<your-strong-random-jwt-secret>

# Encryption Key (64-character hex string)
CHAT_MASTER_KEY=<your-64-character-hex-encryption-key>

# Cloudflare Turnstile Captcha
TURNSTILE_SECRET_KEY=<your-turnstile-secret-key>
SKIP_CAPTCHA=false

# Email Services (SMTP / Brevo)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=<your-email@example.com>
EMAIL_PASS=<your-email-app-password>
BREVO_API_KEY=<your-brevo-api-key>
BREVO_SENDER_EMAIL=no-reply@fuseon.in
BREVO_SENDER_NAME=Fuseon

# GitHub OAuth Integration
GITHUB_CLIENT_ID=<your-github-client-id>
GITHUB_CLIENT_SECRET=<your-github-client-secret>

# Firebase Admin Service Account Key (JSON string or inline object)
FIREBASE_SERVICE_ACCOUNT_KEY={}
